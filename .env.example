# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql://varta:varta@localhost:5432/varta
TEST_DATABASE_URL=postgresql://varta:varta@localhost:5432/varta_test
VALKEY_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=varta-media

# Migrations run as the table owner; the app runs as the restricted varta_api login.
# After pulling migration 0003, point DATABASE_URL at varta_api and keep the owner here:
# DATABASE_URL=postgresql://varta_api:varta_api@localhost:5432/varta
# ALEMBIC_DATABASE_URL=postgresql://varta:varta@localhost:5432/varta
# Only [A-Za-z0-9_.-] allowed. Required when ENVIRONMENT is not "local".
APP_DB_PASSWORD=varta_api
